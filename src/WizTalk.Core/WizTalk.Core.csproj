<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WizTalk.Core — ядро мессенджера: сетевой протокол, кодеки, конфигурация,
    репозиторий SQLite, менеджер клиентов/групп, передача файлов, автоответчик.
    Не зависит от UI и может тестироваться на любой платформе (net8.0).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WizTalk.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.10" />
  </ItemGroup>

</Project>
